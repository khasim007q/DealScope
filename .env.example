# Copy to .env; never commit the real file.
# Live Crustdata calls require a valid API key.
CRUSTDATA_API_KEY=
CRUSTDATA_API_VERSION=2025-11-01
# Set to the balance actually available on your account (GET /account/credits is free).
# Our account has 200 credits (not the 5,000 the hackathon page mentions), so the policy is scaled down:
# 20% reserve that is never spent, and a 40-credit per-case cap (a typical live case estimates ~26 credits).
CRUSTDATA_TOTAL_CREDITS=200
CRUSTDATA_GLOBAL_RESERVE_CREDITS=40
CRUSTDATA_MAX_CASE_CREDITS=40
CRUSTDATA_MAX_ENRICHED_PEOPLE=20
# Person search costs ~0.23 credits/result, so 25 results ~= 5.75 credits per search.
CRUSTDATA_MAX_PEOPLE_SEARCH_RESULTS=25
# Keep empty until exact Jobs API price is confirmed from current account pricing.
CRUSTDATA_JOB_COST_PER_RESULT=
CRUSTDATA_JOB_CALL_RESERVE=

# Runtime inference credentials; coding-agent subscription is not a runtime API key.
# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey).
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
# Optional stronger model used only to escalate report synthesis (e.g. gemini-pro-latest). Leave empty to disable.
LLM_ESCALATION_MODEL=

# Mandatory for a judged runtime trace; app can run fixture tests without it.
NEATLOGS_API_KEY=

DEALSCOPE_MODE=synthetic
DEALSCOPE_DB_PATH=./data/dealscope.sqlite3
DEALSCOPE_MAX_ITERATIONS=8
DEALSCOPE_MAX_TOOL_CALLS=12
DEALSCOPE_MAX_RUNTIME_SECONDS=240
DEALSCOPE_HTTP_TIMEOUT_SECONDS=25
DEALSCOPE_MAX_RETRIES=2
